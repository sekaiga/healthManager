<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.tencent.wxcloudrun.dao.ImageMapper">

    <resultMap id="imageMapper" type="com.tencent.wxcloudrun.model.Image">
        <id property="id" column="id"/>
        <result property="imagePath" column="image_path"/>
        <result property="status" column="status"/>
        <result property="parseResult" column="parse_result"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <insert id="insertImage" parameterType="com.tencent.wxcloudrun.model.Image">
        INSERT INTO images(
            image_path,
            status,
            create_time,
            update_time
        ) VALUES (
            #{imagePath},
            #{status},
            #{createTime},
            #{updateTime}
        )
    </insert>

    <select id="getAllImages" resultMap="imageMapper">
        SELECT * FROM images ORDER BY create_time DESC
    </select>

    <select id="findFirstByStatus" resultMap="imageMapper" parameterType="java.lang.Integer">
        SELECT * FROM images WHERE status = #{status} ORDER BY create_time ASC LIMIT 1
    </select>

    <update id="updateImage" parameterType="com.tencent.wxcloudrun.model.Image">
        UPDATE images SET
            status = #{status},
            parse_result = #{parseResult},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>

</mapper> 